# -------------------------------------------------------------------------------
# Build and install a pinned nlohmann/json version from source.
# -------------------------------------------------------------------------------

# arg1 is force (0 or 1) (no interactive script)
# arg2 is debug (0 or 1) (install debug libraries)

install_nlohmann_from_git() {
  echo "Starting to install Nlohmann Json"
  if [ $1 -eq 0 ]; then
    read -p "Do you want to install Nlohmann Json ? <y/N> " prompt
    OPTION=""
  else
    prompt='y'
    OPTION="-y"
  fi

  if [ $2 -eq 0 ]; then
    debug=0
  else
    debug=1
  fi

  if [[ $prompt =~ [yY](es)* ]]
  then
    GIT_URL=https://github.com/nlohmann/json.git
    NLOHMANN_VERSION=v3.12.0
    echo "Install Nlohmann Json from $GIT_URL"

    # Use a subshell to keep directory changes local and stop on command failures.
    (
      set -e
      cd /tmp
      echo "Downloading Nlohmann $NLOHMANN_VERSION"
      $SUDO rm -rf json

      # fetch only the pinned tag rather than the whole history
      git clone --depth 1 --branch "$NLOHMANN_VERSION" "$GIT_URL"
      cd json
      mkdir _build && cd _build
      "$CMAKE" -G "Unix Makefiles" -DCMAKE_BUILD_TYPE=Release -DJSON_BuildTests=OFF ..
      make
      $SUDO make install
    )
    ret=$?
    rm -Rf /tmp/json/_build
    [[ $ret -ne 0 ]] && return $ret
    echo "Nlohmann Json installation complete"
  else
    echo "Nlohmann Json installation skipped"
  fi

  return 0
}
