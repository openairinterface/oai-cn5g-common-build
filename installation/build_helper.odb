# -------------------------------------------------------------------------------
# Install the pinned ODB runtime libraries from source with the build2 toolchain.
# -------------------------------------------------------------------------------

# arg1 is force (0 or 1) (no interactive script)
# arg2 is debug (0 or 1) (install debug libraries)

install_odb() {
  echo "Starting to install odb"
  if [ $1 -eq 0 ]; then
    read -p "Do you want to install odb ? <y/N> " prompt
    OPTION=""
  else
    prompt='y'
    OPTION="-y"
  fi

  if [[ $prompt =~ [yY](es)* ]]
  then
    BUILD2_VERSION=0.18.1
    LIBODB_VERSION=2.5.0
    C_URL=https://download.build2.org/$BUILD2_VERSION/build2-install-$BUILD2_VERSION.sh
    echo "Install ODB runtime library from $C_URL"

    # Use a subshell to keep directory changes local and stop on command failures.
    (
      set -e
      cd /tmp
      $SUDO rm -rf build2 odb-build

      echo "Downloading build2 $BUILD2_VERSION"
      mkdir build2 && cd build2
      curl -sSfO "$C_URL"
      sh "build2-install-$BUILD2_VERSION.sh" --yes --no-bdep --no-modules --trust yes
      export PATH="$HOME/.build2/bin:$PATH"
      which bpkg
      cd ..

      echo "Build odb runtime libraries $LIBODB_VERSION"
      mkdir odb-build && cd odb-build
      bpkg create -d libodb-gcc cc     \
        config.cxx=g++                 \
        config.cc.coptions=-O3         \
        config.install.root=/usr/local

      cd libodb-gcc
      bpkg add https://pkg.cppget.org/1/stable
      bpkg fetch --trust-yes
      bpkg build "libodb/$LIBODB_VERSION" --yes
      bpkg build "libodb-mysql/$LIBODB_VERSION" --yes

      echo "Install odb runtime libraries"
      $SUDO bpkg install --all --recursive
    )
    ret=$?
    [[ $ret -ne 0 ]] && return $ret
    echo "odb installation complete"
  else
    echo "odb installation skipped"
  fi

  return 0
}
