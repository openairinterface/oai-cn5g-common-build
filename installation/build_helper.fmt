# -------------------------------------------------------------------------------
# Build and install a pinned fmt version from source as a shared library.
# -------------------------------------------------------------------------------

# arg1 is force (0 or 1) (no interactive script)
# arg2 is debug (0 or 1) (install debug libraries)

install_fmt_from_git() {
  echo "Starting to install fmt"
  if [ $1 -eq 0 ]; then
    read -p "Do you want to install fmt? <y/N> " prompt
    OPTION=""
  else
    prompt='y'
    OPTION="-y"
  fi

  if [ $2 -eq 0 ]; then
    debug=0
  else
    debug=1
  fi

  if [[ $prompt =~ [yY](es)* ]]
  then
    GIT_URL=https://github.com/fmtlib/fmt.git
    FMT_VERSION=9.0.0
    echo "Install fmt from $GIT_URL"

    # Use a subshell to keep directory changes local and stop on command failures.
    (
      set -e
      cd /tmp
      echo "Downloading fmt $FMT_VERSION"
      $SUDO rm -rf fmt

      # fetch only the pinned tag rather than the whole history
      git clone --depth 1 --branch "$FMT_VERSION" "$GIT_URL"
      cd fmt
      mkdir _build && cd _build
      "$CMAKE" -G "Unix Makefiles" -DFMT_TEST=OFF -DBUILD_SHARED_LIBS=TRUE ..
      make -j "$(nproc)"
      $SUDO make install
    )
    ret=$?
    rm -Rf /tmp/fmt/_build
    [[ $ret -ne 0 ]] && return $ret
    echo "fmt installation complete"
  else
    echo "fmt installation skipped"
  fi

  return 0
}
