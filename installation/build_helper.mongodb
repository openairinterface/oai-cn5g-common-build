# -------------------------------------------------------------------------------
# Build and install a pinned mongo-cxx-driver version from source.
# -------------------------------------------------------------------------------

# arg1 is force (0 or 1) (no interactive script)
# arg2 is debug (0 or 1) (install debug libraries)

install_mongocxx_from_git() {
  echo "Starting to install mongocxx"
  if [ $1 -eq 0 ]; then
    read -p "Do you want to install mongocxx? <y/N> " prompt
    OPTION=""
  else
    prompt='y'
    OPTION="-y"
  fi

  if [ $2 -eq 0 ]; then
    debug=0
  else
    debug=1
  fi

  if [[ $prompt =~ [yY](es)* ]]
  then
    # Installing pre-requisites
    if [[ $OS_DISTRO == "ubuntu" ]]; then
      PACKAGE_LIST="\
      libmongoc-dev \
      libbson-dev \
      python3 \
      $CMAKE"
    elif [[ "$OS_BASEDISTRO" == "fedora" ]]; then
      PACKAGE_LIST="\
      mongo-c-driver-devel \
      libbson-devel \
      utf8proc-devel \
      openldap-devel \
      cyrus-sasl-devel \
      python3 \
      $CMAKE"
    else
      echo_fatal "$OS_DISTRO is not a supported distribution."
    fi
    echo "Install build tools for mongocxx"
    $SUDO "$INSTALLER" install $OPTION $PACKAGE_LIST
    ret=$?;[[ $ret -ne 0 ]] && return $ret

    GIT_URL=https://github.com/mongodb/mongo-cxx-driver.git
    MONGOCXX_VERSION=r4.4.0
    echo "Install mongocxx from $GIT_URL"

    # Use a subshell to keep directory changes local and stop on command failures.
    (
      set -e
      cd /tmp
      echo "Downloading mongocxx $MONGOCXX_VERSION"
      $SUDO rm -rf mongo-cxx-driver

      # fetch only the pinned tag rather than the whole history
      git clone --depth 1 --branch "$MONGOCXX_VERSION" "$GIT_URL"
      cd mongo-cxx-driver/build
      "$CMAKE" .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DENABLE_TESTS=OFF
      "$CMAKE" --build . -j "$(nproc)"
      $SUDO "$CMAKE" --build . --target install
    )
    ret=$?
    [[ -d /tmp/mongo-cxx-driver ]] && git -C /tmp/mongo-cxx-driver clean -x -d -ff
    [[ $ret -ne 0 ]] && return $ret
    echo "mongocxx installation complete"
  else
    echo "mongocxx installation skipped"
  fi

  return 0
}
