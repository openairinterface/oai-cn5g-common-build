# -------------------------------------------------------------------------------
# Build and install a pinned spdlog version from source as a shared library.
# -------------------------------------------------------------------------------

# arg1 is force (0 or 1) (no interactive script)
# arg2 is debug (0 or 1) (install debug libraries)

install_spdlog_from_git() {
  echo "Starting to install spdlog"
  if [ $1 -eq 0 ]; then
    read -p "Do you want to install spdlog ? <y/N> " prompt
    OPTION=""
  else
    prompt='y'
    OPTION="-y"
  fi

  if [ $2 -eq 0 ]; then
    debug=0
  else
    debug=1
  fi

  if [[ $prompt =~ [yY](es)* ]]
  then
    GIT_URL=https://github.com/gabime/spdlog.git
    SPDLOG_VERSION=v1.17.0
    echo "Install spdlog from $GIT_URL"

    # Use a subshell to keep directory changes local and stop on command failures.
    (
      set -e
      cd /tmp
      echo "Downloading spdlog $SPDLOG_VERSION"
      $SUDO rm -rf spdlog

      # fetch only the pinned tag rather than the whole history
      git clone --depth 1 --branch "$SPDLOG_VERSION" "$GIT_URL"
      cd spdlog
      mkdir _build && cd _build
      "$CMAKE" -G "Unix Makefiles" -DCMAKE_BUILD_TYPE=Release -DSPDLOG_FMT_EXTERNAL=ON -DSPDLOG_BUILD_SHARED=ON ..
      make -j "$(nproc)"
      $SUDO make install
    )
    ret=$?
    rm -Rf /tmp/spdlog/_build
    [[ $ret -ne 0 ]] && return $ret
    echo "spdlog installation complete"
  else
    echo "spdlog installation skipped"
  fi

  return 0
}
