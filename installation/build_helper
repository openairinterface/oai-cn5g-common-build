# -------------------------------------------------------------------------------
# Shell helpers shared by the OAI CN5G build scripts: colored logging,
# distribution detection, package installation and compilation wrappers.
# Sourced, never executed.
# -------------------------------------------------------------------------------

# -------------------------------------------------------------------------------
# Colored logging.
# -------------------------------------------------------------------------------

red='\E[31m'
green='\E[32m'
yellow='\E[33m'
blue='\E[1;34m'
reset_color='\E[00m'
COLORIZE=1

# arg1 is the message
# arg2 is the color (defaults to green)
cecho() {
  local message=${1:-"No Message."}
  local color=${2:-$green}
  [ "$COLORIZE" = "1" ] && message="$color$message$reset_color"
  echo -e "$message"
}

echo_error()   { cecho "$*" $red          ;}
echo_fatal()   { cecho "$*" $red; exit -1 ;}
echo_warning() { cecho "$*" $yellow       ;}
echo_success() { cecho "$*" $green        ;}
echo_info()    { cecho "$*" $blue         ;}

# -------------------------------------------------------------------------------
# Distribution and host detection. Runs at source time and sets the variables
# the per-dependency helpers rely on: INSTALLER, OS_BASEDISTRO, CMAKE and SUDO.
# -------------------------------------------------------------------------------

SUPPORTED_DISTRO="Ubuntu 24.04, RHEL 9.x, UBI 9.x, Rocky-Linux 9.x"
if [ ! -f /etc/os-release ]; then
  echo_fatal "No /etc/os-release file found. You're likely on an unsupported distro."
fi
OS_DISTRO=$(grep "^ID=" /etc/os-release | sed "s/ID=//" | sed "s/\"//g")
OS_RELEASE=$(grep "^VERSION_ID=" /etc/os-release | sed "s/VERSION_ID=//" | sed "s/\"//g")
CMAKE="cmake"
case "$OS_DISTRO" in
  fedora|rocky|rhel) OS_BASEDISTRO="fedora"; INSTALLER="dnf" ;;
  debian|ubuntu)     OS_BASEDISTRO="debian"; INSTALLER="apt-get" ;;
esac

IS_CONTAINER=`grep -E -c "docker|kubepods|podman|buildah|libpod" /proc/self/cgroup || true`

# inside a container we already run as root, so sudo is neither needed nor present
if [ $IS_CONTAINER -eq 0 ] && [ ${IS_DOCKERFILE:-0} -eq 0 ]
then
  SUDO='sudo -S -E'
else
  SUDO=''
  IS_CONTAINER=1
fi

# echoes the running distribution, ex "ubuntu24.04", or "Unknown"
get_distribution_release() {
  local release="$OS_DISTRO$OS_RELEASE"
  echo -n "${release:-Unknown}"
}

# returns 0 if the running distribution is one of $SUPPORTED_DISTRO
check_supported_distribution() {
  case "$(get_distribution_release)" in
    ubuntu24.04|rhel9.[3-8]|rocky9.[3-8]) return 0 ;;
  esac
  return 1
}

# skipped in a container, where the sysctl is usually not writable
disable_ipv6() {
  if [ $IS_CONTAINER -eq 0 ]
  then
    $SUDO sysctl -w net.ipv6.conf.all.disable_ipv6=1
  fi
}

# -------------------------------------------------------------------------------
# Shell utilities.
# -------------------------------------------------------------------------------

# arg1 is the list, ex "item1 item2 ..."
# arg2 is the item to look for
list_include_item() {
  [[ "$1" =~ (^|[[:space:]])"$2"($|[[:space:]]) ]]
}

# -------------------------------------------------------------------------------
# Compilation and unit test wrappers. Both log to $dlog, and compilations()
# also passes $make_args to make; both are set by the calling build script.
# -------------------------------------------------------------------------------

# arg1 is the build subdirectory, built in $OPENAIRCN_DIR/build/<arg1>/build
# arg2 is the make target name, also used as the log file name
# arg3 is the produced executable, absolute or relative to the build directory
# arg4 is verbose (0 or 1)
compilations() {
  echo_info "Compilation log for $3 is here: $dlog/$2.txt"
  cd $OPENAIRCN_DIR/build/$1/build || return 1
  rm -f $3
  if [ "a$4" == "a1" ]; then
    set -o pipefail
    make $make_args $2 |& tee $dlog/$2.txt
  else
    make $make_args $2 > $dlog/$2.txt 2>&1
  fi
  if [ $? -eq 0 ] && [ -s $3 ]; then
    echo_success "$2 compiled"
    return 0
  fi
  echo_error "$2 compilation failed"
  return 1
}

# arg1 is the build subdirectory, as for compilations()
# arg2 is the log file name prefix
# arg3 is ignored, callers pass it to keep the compilations() argument order
# arg4 is verbose (0 or 1)
make_test() {
  echo_success "unit tests start"
  cd $OPENAIRCN_DIR/build/$1/build || return 1
  if [ "a$4" == "a1" ]; then
    make test ARGS="-V" | tee $dlog/$2_test.txt
  else
    make test > $dlog/$2_test.txt 2>&1
  fi
  echo_success "unit tests end"
}

# -------------------------------------------------------------------------------
# Package management.
# -------------------------------------------------------------------------------

update_package_db() {
  local stamp=/tmp/no_more_update_package_db

  # the package database is refreshed at most once an hour
  if [ -f $stamp ] && [ $(( $(date +%s) - $(stat -c %Y $stamp) )) -le 3600 ]; then
    return 0
  fi

  $SUDO $INSTALLER update || return $?
  touch $stamp
}

# on Enterprise Linuxes, ensure EPEL repos are installed
# (provides: libidn2-devel, vconfig, iperf, phpMyAdmin, dkms, ...)
check_enable_epel_repos() {
  local rpm=epel-release-latest-9.noarch.rpm
  EPEL_URL=${EPEL_URL:-"https://dl.fedoraproject.org/pub/epel/$rpm"}

  [[ "$OS_DISTRO" == "rhel" || "$OS_DISTRO" == "centos" ]] || return 0
  if rpm -q epel-release > /dev/null; then
    echo "EPEL repos already present. Good."
    return 0
  fi

  echo "EPEL repos not present. Installing them."
  local idx
  for idx in 1 2 3 4; do
    wget --tries=4 --retry-connrefused --wait=8 --user-agent="Mozilla" "$EPEL_URL" \
      && file $rpm | grep -q "RPM" && break
    # a download can yield an HTML error page instead of an RPM, retry in that case
    echo "Attempt $idx failed: downloaded $(file -b $rpm 2>/dev/null)"
    rm -f $rpm
    sleep 1
  done
  if [ ! -f $rpm ]; then
    echo "Error: Could not download the EPEL-9 RPM file"
    exit 1
  fi

  $SUDO $INSTALLER install $OPTION $rpm
  rm -f $rpm
}

