# -------------------------------------------------------------------------------
# Build and install pinned userspace-rcu, lttng-ust and lttng-tools from source.
# -------------------------------------------------------------------------------

# arg1 is force (0 or 1) (no interactive script)
# arg2 is debug (0 or 1) (install debug libraries)

install_lttng_from_git() {
  echo "Starting to install lttng"

  if [ $1 -eq 0 ]; then
    read -p "Do you want to install lttng-userspace-rcu, lttng-ust and lttng-tools? <y/N> " prompt
    OPTION=""
  else
    prompt='y'
    OPTION="-y"
  fi

  if [ $2 -eq 0 ]; then
    debug=0
  else
    debug=1
  fi

  if [[ $prompt =~ [yY](es)* ]]
  then
    ###################################################
    GIT_URL=https://git.lttng.org/userspace-rcu.git
    URCU_VERSION=v0.15.6
    echo "Install lttng-userspace-rcu from $GIT_URL"

    # Use a subshell to keep directory changes local and stop on command failures.
    (
      set -e
      cd /tmp
      echo "Downloading lttng-userspace-rcu $URCU_VERSION"
      $SUDO rm -rf userspace-rcu

      # fetch only the pinned tag rather than the whole history
      git clone --depth 1 --branch "$URCU_VERSION" "$GIT_URL"
      cd userspace-rcu
      ./bootstrap
      ./configure
      make -j "$(nproc)"
      $SUDO make install
      $SUDO ldconfig
    )
    ret=$?
    [[ -d /tmp/userspace-rcu ]] && git -C /tmp/userspace-rcu clean -x -d -ff
    [[ $ret -ne 0 ]] && return $ret

    ###################################################
    GIT_URL=https://git.lttng.org/lttng-ust.git
    LTTNG_UST_VERSION=v2.13.10
    echo "Install lttng-ust from $GIT_URL"

    # Use a subshell to keep directory changes local and stop on command failures.
    (
      set -e
      cd /tmp
      echo "Downloading lttng-ust $LTTNG_UST_VERSION"
      $SUDO rm -rf lttng-ust

      # fetch only the pinned tag rather than the whole history
      git clone --depth 1 --branch "$LTTNG_UST_VERSION" "$GIT_URL"
      cd lttng-ust
      ./bootstrap
      ./configure --disable-man-pages --disable-examples
      make -j "$(nproc)"
      $SUDO make install
      $SUDO ldconfig
    )
    ret=$?
    [[ -d /tmp/lttng-ust ]] && git -C /tmp/lttng-ust clean -x -d -ff
    [[ $ret -ne 0 ]] && return $ret

    ###################################################
    GIT_URL=https://git.lttng.org/lttng-tools.git
    LTTNG_TOOLS_VERSION=v2.13.15
    echo "Install lttng-tools from $GIT_URL"

    # Use a subshell to keep directory changes local and stop on command failures.
    (
      set -e
      cd /tmp
      echo "Downloading lttng-tools $LTTNG_TOOLS_VERSION"
      $SUDO rm -rf lttng-tools

      # fetch only the pinned tag rather than the whole history
      git clone --depth 1 --branch "$LTTNG_TOOLS_VERSION" "$GIT_URL"
      cd lttng-tools
      ./bootstrap
      ./configure --disable-man-pages
      make -j "$(nproc)"
      $SUDO make install
      $SUDO ldconfig
    )
    ret=$?
    [[ -d /tmp/lttng-tools ]] && git -C /tmp/lttng-tools clean -x -d -ff
    [[ $ret -ne 0 ]] && return $ret
    echo "lttng installation complete"
  else
    echo "lttng installation skipped"
  fi

  return 0
}
