# -------------------------------------------------------------------------------
# Build and install a pinned Pistache version from source with Meson.
# -------------------------------------------------------------------------------

# arg1 is force (0 or 1) (no interactive script)
# arg2 is debug (0 or 1) (install debug libraries)

install_pistache_from_git() {
  echo "Starting to install pistache"
  if [ $1 -eq 0 ]; then
    read -p "Do you want to install Pistache ? <y/N> " prompt
    OPTION="-y"
  else
    prompt='y'
    OPTION="-y"
  fi

  if [ $2 -eq 0 ]; then
    debug=0
  else
    debug=1
  fi

  if [[ $prompt =~ [yY](es)* ]]
  then
    GIT_URL=https://github.com/pistacheio/pistache.git
    PISTACHE_VERSION=v0.4.26
    echo "Install Pistache from $GIT_URL"

    # Use a subshell to keep directory changes local and stop on command failures.
    (
      set -e
      cd /tmp
      echo "Downloading Pistache $PISTACHE_VERSION"
      $SUDO rm -rf pistache

      # fetch only the pinned tag rather than the whole history
      git clone --depth 1 --branch "$PISTACHE_VERSION" "$GIT_URL"
      cd pistache
      meson setup _build --buildtype=release --libdir=lib
      ninja -C _build
      $SUDO ninja -C _build install
    )
    ret=$?
    rm -Rf /tmp/pistache/_build
    [[ $ret -ne 0 ]] && return $ret
    echo "pistache installation complete"
  else
    echo "pistache installation skipped"
  fi

  return 0
}
