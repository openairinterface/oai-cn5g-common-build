#-------------------------------------------------------------------------------
# arg1 is force (0 or 1) (no interactive script)
# arg2 is debug (0 or 1) (install debug libraries)

install_pistache_from_git() {
  echo "Starting to install pistache"
  if [ $1 -eq 0 ]; then
    read -p "Do you want to install Pistache ? <y/N> " prompt
    OPTION="-y"
  else
    prompt='y'
    OPTION="-y"
  fi
  if [ $2 -eq 0 ]; then
    debug=0
  else
    debug=1
  fi


  if [[ $prompt =~ [yY](es)* ]]
  then
    GIT_URL=https://github.com/pistacheio/pistache.git
    PISTACHE_TAG="v0.4.26"

    echo "Install Pistache from $GIT_URL ($PISTACHE_TAG)"
    pushd /tmp

    echo "Downloading Pistache"
    if [[ $OPTION =~ -[yY](es)* ]]
    then
      $SUDO rm -rf pistache
    fi

    git clone $GIT_URL
    ret=$?; [[ $ret -ne 0 ]] && popd && return $ret
    cd pistache || return 1
    git checkout $PISTACHE_TAG
    ret=$?; [[ $ret -ne 0 ]] && popd && return $ret

    echo "Configuring Meson build"
    mkdir -p build
    meson setup build \
      --buildtype=release \
      --libdir=lib
    ret=$?; [[ $ret -ne 0 ]] && popd && return $ret

    echo "Building Pistache with Ninja"
    ninja -C build
    ret=$?; [[ $ret -ne 0 ]] && popd && return $ret

    echo "Installing Pistache"
    $SUDO ninja -C build install
    ret=$?; [[ $ret -ne 0 ]] && popd && return $ret

    popd
    rm -Rf /tmp/pistache/_build
  fi

  echo "pistache installation complete"
  return 0
}
