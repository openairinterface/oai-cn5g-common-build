# -------------------------------------------------------------------------------
# Build and install a pinned CPP-JWT version from source.
# -------------------------------------------------------------------------------

# arg1 is force (0 or 1) (no interactive script)
# arg2 is debug (0 or 1) (install debug libraries)

install_cpp_jwt_from_git() {
  echo "Starting to install cpp_jwt"
  if [ $1 -eq 0 ]; then
    read -p "Do you want to install CPP-JWT ? <y/N> " prompt
    OPTION=""
  else
    prompt='y'
    OPTION="-y"
  fi

  if [[ $prompt =~ [yY](es)* ]]
  then
    GIT_URL=https://github.com/arun11299/cpp-jwt.git
    CPP_JWT_VERSION=v1.5.1
    echo "Install Cpp-jwt from $GIT_URL"

    # Use a subshell to keep directory changes local and stop on command failures.
    (
      set -e
      cd "$OPENAIRCN_DIR/build/ext"
      echo "Downloading CPP-JWT $CPP_JWT_VERSION"
      $SUDO rm -rf cpp-jwt

      # fetch only the pinned tag rather than the whole history
      git clone --depth 1 --branch "$CPP_JWT_VERSION" "$GIT_URL"
      cd cpp-jwt
      mkdir _build && cd _build
      "$CMAKE" \
        -DCPP_JWT_BUILD_TESTS=OFF \
        -DCPP_JWT_BUILD_EXAMPLES=OFF ..
      make
      $SUDO make install
    )
    ret=$?
    rm -Rf "$OPENAIRCN_DIR/build/ext/cpp-jwt/_build"
    [[ $ret -ne 0 ]] && return $ret
    echo "cpp_jwt installation complete"
  else
    echo "cpp_jwt installation skipped"
  fi

  return 0
}
