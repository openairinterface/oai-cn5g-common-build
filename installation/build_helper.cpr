# -------------------------------------------------------------------------------
# Build and install a pinned libcpr version from source as a shared library.
# -------------------------------------------------------------------------------

# arg1 is force (0 or 1) (no interactive script)
# arg2 is debug (0 or 1) (install debug libraries)

install_cpr_from_git() {
  echo "Starting to install cpr"
  if [ $1 -eq 0 ]; then
    read -p "Do you want to install cpr? <y/N> " prompt
    OPTION=""
  else
    prompt='y'
    OPTION="-y"
  fi

  if [ $2 -eq 0 ]; then
    debug=0
  else
    debug=1
  fi

  if [[ $prompt =~ [yY](es)* ]]
  then
    GIT_URL=https://github.com/libcpr/cpr.git
    CPR_VERSION=1.14.2
    echo "Install cpr from $GIT_URL"

    # Use a subshell to keep directory changes local and stop on command failures.
    (
      set -e
      cd /tmp
      echo "Downloading cpr $CPR_VERSION"
      $SUDO rm -rf cpr

      # fetch only the pinned tag rather than the whole history
      git clone --depth 1 --branch "$CPR_VERSION" "$GIT_URL"
      cd cpr
      mkdir build && cd build
      cmake .. -DCPR_USE_SYSTEM_CURL=ON -DCPR_BUILD_TESTS=OFF -DBUILD_SHARED_LIBS=ON
      cmake --build . --parallel
      $SUDO cmake --install .
    )
    ret=$?
    [[ -d /tmp/cpr ]] && git -C /tmp/cpr clean -x -d -ff .
    [[ $ret -ne 0 ]] && return $ret
    echo "cpr installation complete"
  else
    echo "cpr installation skipped"
  fi

  return 0
}
